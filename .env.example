# Copy to .env and fill in. Never commit .env.

# Exa: looks up unknown laws, 404s and implicit claims
EXA_API_KEY=

# Gemini via Google AI Studio: finds explicit + implicit legal references.
# Without AI_API_KEY *and* AI_MODEL the AI step is skipped and a rule-based
# fallback finds explicit references only.
AI_PROVIDER=gemini
# Key from https://aistudio.google.com/apikey (starts with "AIza")
AI_API_KEY=
# Required: a model ID from AI Studio's model list, without the "models/" prefix
AI_MODEL=gemini-3.5-flash

# Leave empty for Gemini (the app uses Google's OpenAI-compatible endpoint).
# Only set it with AI_PROVIDER=custom for another OpenAI-compatible endpoint.
AI_BASE_URL=

# Name used to sign the drafted reply letter
ORG_NAME=Camden Council

DATA_DIR=./data
