# Copy to .env and fill in. Never commit .env.

# --- Exa (primary engine: discovery, regulator pages, snapshots, provenance, precedent)
EXA_API_KEY=

# --- AI validation layer (optional; the app runs without it)
# Any OpenAI-compatible chat-completions endpoint:
#   AI_PROVIDER=openai  -> https://api.openai.com/v1 (default)
#   AI_PROVIDER=gemini  -> Google's OpenAI-compatible endpoint
#   AI_PROVIDER=custom  -> set AI_BASE_URL (e.g. Hostinger AI Router)
AI_PROVIDER=openai
AI_API_KEY=
# Required when AI_API_KEY is set: a model your key can use (check your provider's model list)
AI_MODEL=
AI_BASE_URL=

DATA_DIR=./data
