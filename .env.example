# Copy to .env and fill in. Never commit .env.

# Exa: looks up unknown laws, 404s and implicit claims
EXA_API_KEY=

# Gemini: finds explicit + implicit legal references (without it, a rule-based fallback finds explicit ones)
AI_PROVIDER=gemini
AI_API_KEY=
# A Gemini model your key can use (see Google AI Studio's model list)
AI_MODEL=

# Optional: AI_PROVIDER=openai, or AI_PROVIDER=custom with AI_BASE_URL for any OpenAI-compatible endpoint
AI_BASE_URL=
DATA_DIR=./data
